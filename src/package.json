{
  "name": "smart-collab",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@smart-collab/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @smart-collab/web test:e2e",
    "test:db": "bash supabase/scripts/test-db.sh"
  },
  "devDependencies": {
    "turbo": "2.11.13"
  }
}
